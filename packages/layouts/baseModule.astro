---
interface Props {
  isDev?: boolean
  isIndex?: boolean
  keywords?: string[]
  banner?: boolean
  path?: boolean
}
const { isDev = false, isIndex = false, keywords = [], banner = false, path = false } = Astro.props
---

{
  isDev ? (
    <html lang="zh-Hant">
      <head>
        <meta charset="UTF-8" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
        <meta http-equiv="Content-Language" content="zh-Tw" />
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
        <meta http-equiv="Content-Script-Type" content="text/javascript" />
        <meta http-equiv="Content-Style-Type" content="text/css" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/normalize/3.0.2/normalize.css" />
        <script is:inline src="https://pic03.eapple.com.tw/yk_js_web/jquery-1.11.3.min.js" />
        <script is:inline src="https://pic03.eapple.com.tw/yk_js_web/scrollfade.js" />

        {/* 這個demo有個奇怪的BUG，放入除了style外的其他東西只會出現在開發模式，唯獨style會被跟著打包，明明打包區域沒有使用到<slot name="demo" />，無解。 */}
        <slot name="demo" />
        <slot name="head" />
      </head>
      <body>
        <div class="opsl">
          <slot />
        </div>
      </body>
    </html>
  ) : (
    // 紀錄: 原始情況是有 head 標籤和模組根標籤，照理說要包一層 Fragment 讓它是單一 JSX 節點，但是在 head 外包一層 Fragment 會使打包時style跑到最頂層，解決方式就是加入 html 標籤，並連同 head 標籤給腳本刪除，改用 html 使根標籤保持唯一
    <html>
      <head>
        <script is:inline src="https://pic03.eapple.com.tw/yk_js_web/scrollfade.js" />
        <slot name="head" />
        {!(banner && path) && <Fragment set:html={`<style>${path ? '' : '.path'}${!banner && !path ? ',' : ''}${banner ? '' : '.banner'} { display: none; }</style>\n`} />}
      </head>
      <div class="opsl">
        {isIndex && (
          <div class="key_words">
            <h2>{keywords[0]}</h2>
            <h3>{keywords[1]}</h3>
            <h4>{keywords[2]}</h4>
            <h5>{keywords[3]}</h5>
            <h6>{keywords[4]}</h6>
          </div>
        )}
        <slot />
      </div>
    </html>
  )
}

<style is:global>
  /* reset module8 */
  .edit,
  .edit_part,
  .show_content,
  .main_part {
    width: 100% !important;
    max-width: 100% !important;
    margin: auto !important;
    padding: 0px !important;
  }
  .pageIndex .main_part {
    border: none !important;
  }
  .animated15 {
    opacity: 1;
    transform: none;
    animation: none;
  }
  /* 隱藏關鍵字 */
  .key_words {
    padding: 0 !important;
    height: 0 !important;
    overflow: hidden;
  }
  .key_words :is(h2, h3, h4, h5, h6) {
    color: #fff0;
  }
  /* 重製公司的白痴設定 */
  .opsl,
  .opsl :where(*:not(.fa-solid)) {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    top: auto;
    right: auto;
    bottom: auto;
    left: auto;
    color: inherit;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    word-break: inherit;
  }
  .opsl hr {
    height: auto;
  }
  .opsl :where(h3, h4, h5, h6) {
    line-height: 1.2;
  }
  @layer base {
    .opsl {
      position: relative;
      width: 100%;
      margin: 0 auto;
    }
    .opsl,
    .opsl * {
      max-width: 100%;
      text-decoration: none;
      list-style: none;
      font: inherit;
      color: inherit;
    }
    .opsl *::before,
    .opsl *::after {
      box-sizing: border-box;
    }
    .opsl iframe {
      display: block;
    }
    .opsl img {
      vertical-align: middle;
    }
    .opsl table {
      border-collapse: collapse;
    }
    .opsl a,
    .opsl a * {
      transition: 0.5s;
    }
    .opsl hr {
      border-style: solid;
      border-bottom: none;
      border-right: none;
    }
  }
</style>

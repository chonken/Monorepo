---
import { type SidePaddingProps, id, props as defaultProps } from './index.type'
import { mergeClasses, parseUnit, parseDualUnit } from '../../utils'

interface Props extends SidePaddingProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}
const { element, class: className, maxWidthStart, maxWidthEnd, mobile, mobileFill, paddingInline, paddingBlock, marginBlock, minPaddingInline, ...rest } = props

const Element = element as keyof HTMLElement

const processPadding = (padding: string | number) => {
  return padding === 'auto' ? '100%' : parseUnit(padding, 'px')
}

const styleList = {
  '--pdb': parseDualUnit(paddingBlock, 'px').join(' '),
  '--mgb': parseDualUnit(marginBlock, 'px').join(' '),
  '--mws': processPadding(maxWidthStart),
  '--mwe': processPadding(maxWidthEnd),
  '--pdi': parseUnit(paddingInline, '%'),
  '--mpdi': parseUnit(minPaddingInline, 'px'),
}
const classList = mergeClasses(className, ['ch-spd', ...(mobile === 'none' ? [] : [`mob-${mobile}`, `${mobileFill ? 'mob-fill' : ''}`])])
---

<Element class:list={classList} style={styleList} {...rest}>
  <slot />
</Element>

<style lang="scss" is:global>
  @use '../../config/breakpoint' as bp;

  .ch-spd {
    --mpd: max(var(--pdi), var(--mpdi));
    margin-block: var(--mgb);
    padding-block: var(--pdb);
    padding-inline: calc(max(50% - var(--mws) / 2, var(--mpd))) calc(max(50% - var(--mwe) / 2, var(--mpd))) !important;
  }

  // 手動設定和對應尺寸
  $map: (
    2xl: '.mob-2xl',
    xl: '.mob-xl',
    lg: '.mob-lg',
    md: '.mob-md',
  );

  @each $size, $mobile in $map {
    @media (max-width: bp.size($size)) {
      #{$mobile}:is(.ch-pdl, .ch-pdr) {
        padding-inline: max(var(--pdi), var(--mpdi)) !important;
      }
      #{$mobile}.mob-fill:is(.ch-pdl, .ch-pdr) {
        padding-inline: 0 !important;
      }
    }
  }
</style>

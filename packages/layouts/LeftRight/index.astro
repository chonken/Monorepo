---
import { type LeftRightProps, id, props as defaultProps } from './index.type'
import { mergeClasses, parseUnit, parseDualUnit, isNegative, toNegative } from '../../utils'
import Content from '../../components/Content.astro'
import { containerStyleList, containerClassList } from '../Container/index.type'
import { flexClassList, flexStyleList } from '../../components/Flex/index.type'
import '../../styles/container.scss'
import '../../styles/flex.scss'

interface Props extends LeftRightProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}
const { element, class: className, maxWidth,  item, justify, gap: g, reverse, flexReverse, mobile, mobileItem, mobileJustify, mobileFit, mobileReverse, center, overlay: oly, contentWidth, contentDirection, ...args } = props
const { wrap, ...rest } = args

const Element = element as keyof HTMLElement

// 處理間距和疊層
const [rowGap, cGap] = parseDualUnit(g, 'px')
const o = toNegative(parseUnit(oly, 'px'))
const overlay = o === '-0px' ? (isNegative(cGap) ? cGap : '0px') : o
const colGap = overlay === '0px' ? cGap : '0px'
const gap = `${rowGap} ${colGap}`

const styleList = {
  '--oly': toNegative(parseUnit(oly, 'px')),
  ...containerStyleList(maxWidth),
  ...flexStyleList({  item, justify, gap, mobileItem, mobileJustify }),
}
const classList = mergeClasses(className, [
  id,
  ...(mobile === 'none' ? [] : [mobileFit ? 'mob-fit' : '']),
  ...containerClassList(center),
  ...flexClassList({
    reverse,
    flexReverse,
    mobile: 'lg' as const,
    mobileReverse,
  }),
])
---

<Element class:list={classList} style={styleList} {...rest}>
  {Astro.slots.has('image') && <slot name="image" />}
  <slot />
  {
    Astro.slots.has('content') && (
      <Content width={contentWidth} direction={contentDirection}>
        <slot name="content" />
      </Content>
    )
  }
</Element>

<style lang="scss" is:global>
  @use '../../config/breakpoint' as bp;
  .ch-l-r {
    & > * {
      position: relative;
      z-index: 1;
    }
  }
  :where(.ch-l-r) > :is(:last-child, .ch-cnt) {
    margin-inline-start: var(--oly);
    z-index: 2;
  }

  // 手動設定尺寸
  $map: 2xl, xl, lg, md, sm;

  @each $size in $map {
    @media (max-width: bp.size($size)) {
      .ch-l-r.mob-#{$size} {
        &.mob-fit {
          margin-inline: auto;
          width: fit-content;
        }
        & > :is(:last-child, .ch-cnt) {
          margin-inline: 0;
        }
      }
    }
  }
</style>

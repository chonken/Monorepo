---
import { type GridItemProps, id, props as defaultProps } from './index.type'
import { mergeClasses, parseUnit, parseDualUnit, parseRWD, fullRWD, setRWD } from '../../utils'
import { containerStyleList, containerClassList } from '../Container/index.type'
import { flexClassList, flexStyleList } from '../../components/Flex/index.type'
import '../../styles/container.scss'
import '../../styles/flex.scss'

interface Props extends GridItemProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}
const { element, class: className, maxWidth, item, justify, gap, col, center, ...args } = props
const { wrap, reverse, flexReverse, mobile, mobileItem, mobileJustify, mobileReverse, ...rest } = args

const Element = element as keyof HTMLElement

// RWD尺寸(由大到小排序)
const sizes = ['3xl', '2xl', 'xl', 'lg', 'md', 'sm', 'xs', '2xs']

// 解析gap
const [_, colGap] = parseDualUnit(gap)
// 解析col
// bug 沒有默認的話，未指定的高尺寸會出錯，直到有指定
const colMap = setRWD(fullRWD(parseRWD(col), sizes))

const styleList = {
  ...containerStyleList(maxWidth),
  ...flexStyleList({ item, justify, gap }),
  '--cgap': colGap || '0px',
  ...colMap,
}
const classList = mergeClasses(className, [id, ...containerClassList(center), ...flexClassList()])
---

<Element class:list={classList} style={styleList} {...rest}><slot /></Element>

<style lang="scss" is:global>
  @use '../../config/breakpoint' as bp;
  .ch-gdi {
    & > * {
      max-width: calc((100% - var(--cgap, 0) * max(var(--col) - 1, 0)) / var(--col));
    }
  }
  :where(.ch-gdi) > * {
    width: 100%;
  }

  @each $size, $value in bp.$breakpoint {
    @media (max-width: #{$value}px) {
      .ch-gdi {
        $gap: var(--cgap, 0);

        @if $value < bp.value('sm') {
          $gap: 20px;
        } @else if $value < bp.value('xs') {
          $gap: 10px;
        }

        &.ch-fixed {
          max-width: calc((var(--mw) - #{$gap} * max(var(--col) - 1, 0)) / var(--col) * var(--col-#{$size}) + (var(--col-#{$size}) - 1) * #{$gap});
        }
        & > * {
          max-width: calc((100% - #{$gap} * max(var(--col-#{$size}) - 1, 0)) / var(--col-#{$size}));
        }
      }
    }
  }
</style>

---
import type { ElementProps } from '../type/element'
import ItemLine from './interface/_itemLine.astro'
import { mergeClasses } from '../utils'

export interface ProcessTimelineItemProps extends ElementProps {
  reverse?: boolean
}
interface Props extends ProcessTimelineItemProps {}

const { id, class: className = '', reverse = false, ...rest } = Astro.props

const classList = mergeClasses(className, ['ch-ptli', reverse ? 'reverse' : ''])
---

<li id={id} class:list={classList} {...rest}>
  <div class="ch-ptli-l">
    <slot name="left" />
  </div>
  {
    Astro.slots.has('marker') ? (
      <ItemLine markerClass="ch-ptli-m" lineClass="ch-ptli-n">
        <slot name="marker" slot="marker" />
      </ItemLine>
    ) : (
      <ItemLine markerClass="ch-ptli-m" lineClass="ch-ptli-n" />
    )
  }
  <div class="ch-ptli-r">
    <slot />
    <slot name="right" />
  </div>
</li>

<style lang="scss" is:global>
  @use '../config/breakpoint' as bp;
  .ch-ptli {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content minmax(0, 1fr);
    align-items: var(--itm);
    margin-block: 0 !important;
    padding-block: 0 !important;
    column-gap: var(--cgap);
  }
  .ch-ptli:first-of-type {
    margin-top: calc(var(--rpd-t) * -1) !important;
  }
  .ch-ptli:last-of-type {
    margin-bottom: calc(var(--rpd-b) * -1) !important;
  }
  :where(.ch-ptl.odd-reverse) > .ch-ptli:nth-of-type(even),
  .ch-ptli:where(.reverse) {
    direction: rtl;
  }
  .ch-ptli-l,
  .ch-ptli-r {
    padding-block: var(--rpd-t) var(--rpd-b);
  }

  // 手動設定尺寸
  $map: lg, md, sm, xs, 2xs;

  @each $size in $map {
    @media (max-width: bp.size($size)) {
      .mob-#{$size} > .ch-ptli {
        grid-template-columns: max-content 1fr;
        align-items: var(--mob-itm);
        column-gap: 20px;
        direction: ltr;
        & > .ch-ptli-l {
          padding-block-end: 0;
        }
        & > .ch-ptli-r {
          padding-block-start: 0;
        }
        & > .ch-ptli-m {
          order: -1;
          grid-row: span 2;
          & .ch-ptli-n:first-child {
            max-height: var(--mob-lt);
            height: var(--mob-lt);
          }
          & .ch-ptli-n:last-child {
            max-height: var(--mob-lb);
            height: var(--mob-lb);
          }
        }
      }
    }
  }
</style>

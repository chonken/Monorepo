---
import { mergeClasses } from '../../utils'
import Button from '../_prototype/button.astro'
import type { BtnCurtainProps } from './index.type'
import { id, props as defaultProps } from './index.props'

interface Props extends BtnCurtainProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}

const { class: className, backgroundColor, color, curtain, curtainWidth, open, ...rest } = props

const styleList = {
  '--bgc': backgroundColor,
  '--clr': color,
  '--curw': curtainWidth,
}
const classList = mergeClasses(className, [id, `cur-${curtain[0]}`, `${open ? 'ch-open' : ''}`])
---

<Button class:list={classList} style={styleList} {...rest}>
  <span class="ch-btnptt-txt">
    <slot>查看更多</slot>
  </span>
</Button>

<style lang="scss" is:global>
  .ch-btn-cur {
    position: relative;
    color: var(--clr);
    background-color: var(--bgc);
    transition: 0.5s ease-in-out;
    z-index: 1;
    &::before {
      content: '';
      position: absolute;
      width: var(--curw);
      height: 100%;
      transition: 0.4s;
      background-color: var(--clr);
      z-index: -1;
    }
    &.ch-open > span {
      color: var(--bgc);
    }
    &.ch-open::before {
      width: 100%;
    }
    &.cur-l::before {
      top: 0;
      left: 0;
    }
    &.cur-r::before {
      top: 0;
      right: 0;
    }
    &.cur-t::before {
      left: 0;
      top: 0;
    }
    &.cur-b::before {
      left: 0;
      bottom: 0;
    }
    &:hover > span {
      color: var(--bgc);
    }
    &:hover::before {
      width: 100%;
    }
    &.ch-open:hover > span {
      color: var(--clr);
    }
    &.ch-open:hover::before {
      width: var(--curw);
    }
  }
</style>

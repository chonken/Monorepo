---
import type { RotateProps } from './index.type'
import { id, props as defaultProps } from './index.props'
import { mergeClasses, parseUnit } from '../../utils'

interface Props extends RotateProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}
const { element, class: className, rotate, seconds, delay, loop, reverse, ...rest } = props
const timing = loop ? `linear ${reverse ? 'reverse' : ''}` : 'ease-in-out alternate'

const Element = element as keyof HTMLElement

const styleList = {
  '--sec': parseUnit(seconds, 's'),
  '--rot': parseUnit(loop ? '360deg' : rotate, 'deg'),
  '--dly': parseUnit(delay, 's'),
  '--tim': timing,
}
const classList = mergeClasses(className, id)
---

<Element class:list={classList} style={styleList} {...rest}><slot /></Element>

<style is:global>
  .ch-rot > * {
    --deg: calc(var(--rot) / 2);
    display: block;
    max-width: 100%;
    max-height: 100%;
    animation: rotate var(--sec) var(--dly) infinite var(--tim);
  }
  @keyframes rotate {
    0% {
      transform: rotate(calc(var(--deg) * -1));
    }
    100% {
      transform: rotate(var(--deg));
    }
  }
</style>

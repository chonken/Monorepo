---
import type { TopLineListItemProps } from './Item.type'
import { id, props as defaultProps } from './Item.props'
import ItemLine from '../_prototype/itemLine.astro'
import { mergeClasses } from '../../utils'

interface Props extends TopLineListItemProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}
const { class: className, lineClass, dotClass, ...rest } = props

const classList = mergeClasses(className, id)
---

<li class:list={classList} {...rest}>
  {
    Astro.slots.has('icon') && (
      <div class="ch-hlli-g">
        <slot name="icon" />
      </div>
    )
  }
  {
    Astro.slots.has('marker') ? (
      <ItemLine listDirection="row" lineClass={lineClass} dotClass={dotClass}>
        <slot name="marker" slot="marker" />
      </ItemLine>
    ) : (
      <ItemLine listDirection="row" lineClass={lineClass} dotClass={dotClass} />
    )
  }
  <div class="ch-hlli-t"><slot /></div>
</li>

<style lang="scss" is:global>
  @use '../../config/breakpoint' as bp;
  .ch-hlli {
    display: flex;
    flex-direction: column;
    margin-inline: 0 !important;
    padding-inline: 0 !important;
    width: calc(100% / var(--col));
  }
  :where(.ch-hll-b) > .ch-hlli {
    flex-direction: column-reverse;
  }
  .ch-hlli-g {
    padding-inline: var(--pd-s) var(--pd-e);
  }
  .ch-hlli-t {
    padding-inline: var(--pd-s) var(--pd-e);
    width: 100%;
    flex-grow: 1;
  }
  @each $size, $value in bp.$breakpoint {
    @media (max-width: #{$value}px) {
      .ch-hlli {
        width: calc(100% / var(--col-#{$size}));
      }
    }
  }
</style>

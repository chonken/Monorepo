---
import { mergeClasses } from '../../utils'
import Button from '../_prototype/button.astro'
import type { Btn02Props } from './index.type'
import { id, props as defaultProps } from './index.props'

interface Props extends Btn02Props {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}

const { class: className = '', color, backgroundColor, shadow, ...rest } = props

const styleList = {
  '--clr': color,
  '--bgc': backgroundColor,
  '--shd': shadow,
}
const classList = mergeClasses(className, id)
---

<Button class:list={classList} style={styleList} {...rest}>
  <span class="ch-btnptt-txt">
    <slot>查看更多</slot>
  </span>
</Button>

<style lang="scss" is:global>
  .btn_type02 {
    color: var(--clr);
    background: var(--bgc);
    &:hover {
      transform: translateX(10px);
      box-shadow: -5px 0px 5px var(--shd);
    }
  }
</style>

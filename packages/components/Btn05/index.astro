---
import { mergeClasses } from '../../utils'
import Button from '../_prototype/button.astro'
import type { Btn05Props } from './index.type'
import { id, props as defaultProps } from './index.props'

interface Props extends Btn05Props {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}

const { class: className, color, backgroundColor, borderColor, ...rest } = props

const styleList = {
  '--clr': color,
  '--bgc': backgroundColor,
  '--bor-c': borderColor,
}
const classList = mergeClasses(className, id)
---

<Button class:list={classList} style={styleList} {...rest}>
  <span class="ch-btnptt-txt">
    <slot>查看更多</slot>
  </span>
</Button>

<style lang="scss" is:global>
  .btn_type05 {
    position: relative;
    color: var(--clr);
    &::before,
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      transition: all 0.3s;
    }
    &::before {
      background: var(--bgc);
      z-index: 1;
      opacity: 0.1;
    }
    &::after {
      border: 1px solid var(--bor-c);
      transform: scale(1.5);
      opacity: 0;
    }
    & .ch-btn-icon {
      flex-shrink: 0;
      transition: 0.4s;
    }
    &:hover::before {
      transform: scale(0);
      opacity: 0;
    }
    &:hover:after {
      transform: scale(1);
      opacity: 0.5;
    }
  }
</style>

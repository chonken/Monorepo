---
import type { GridItemProps } from './index.type'
import { id, props as defaultProps } from './index.props'
import { mergeClasses, parseDualUnit, parseRWD, fullRWD, setRWD } from '../../utils'
import { containerStyleList, containerClassList } from '../Container/index.props'
import { flexStyleList } from '../../components/Flex/index.props'

interface Props extends GridItemProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}
const { element, class: className, maxWidth, item, justify, gap, col, center, maxWidthFit, ...rest } = props

const Element = element as keyof HTMLElement

// RWD尺寸(由大到小排序)
const sizes = ['3xl', '2xl', 'xl', 'lg', 'md', 'sm', 'xs', '2xs']

// 解析gap
const [_, colGap] = parseDualUnit(gap)
// 解析col
const colMap = setRWD(fullRWD(parseRWD(col), sizes))

const styleList = {
  ...containerStyleList({ maxWidth }),
  ...flexStyleList({ item, justify, gap }),
  '--cgap': colGap || '0px',
  ...colMap,
}
const classList = mergeClasses(className, [id, ...containerClassList({ center }), `${maxWidthFit ? 'ch-gdi-fit' : ''}`])
---

<Element class:list={classList} style={styleList} {...rest}><slot /></Element>

<style lang="scss" is:global>
  @use '../../config/breakpoint' as bp;

  .ch-gdi {
    display: flex;
    flex-wrap: wrap;
    align-items: var(--itm);
    justify-content: var(--jst);
    gap: var(--gap);
    max-width: 100%;
    width: var(--mw);
    &.ch-ctr-cen {
      margin-inline: auto;
    }
    & > * {
      max-width: 100%;
      width: calc((100% - var(--cgap) * max(var(--col) - 1, 0)) / var(--col));
    }
  }

  @each $size, $value in bp.$breakpoint {
    @media (max-width: #{$value}px) {
      .ch-gdi {
        $gap: var(--cgap);
        @if $value <= bp.value('sm') {
          $gap: 10px;
          column-gap: $gap;
        } @else if $value <= bp.value('lg') {
          $gap: 20px;
          column-gap: $gap;
        }

        &.ch-gdi-fit {
          width: calc((var(--mw) - var(--cgap) * max(var(--col) - 1, 0)) / var(--col) * var(--col-#{$size}) + (var(--col-#{$size}) - 1) * #{$gap});
        }
        & > * {
          width: calc((100% - #{$gap} * max(var(--col-#{$size}) - 1, 0)) / var(--col-#{$size}));
        }
      }
    }
  }
</style>

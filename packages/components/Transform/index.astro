---
import type { TransformProps } from './index.type'
import { id, props as defaultProps } from './index.props'
import { mergeClasses, parseMultiUnit, parseUnit } from '../../utils'

interface Props extends TransformProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}

const { element, class: className, translate, rotate, scale, skew, seconds, delay, style, ...rest } = props

const Element = element as keyof HTMLElement

const transforms: string[] = []
if (translate) transforms.push(`translate(${parseMultiUnit(translate, '%')})`)
if (rotate) transforms.push(`rotate(${parseMultiUnit(rotate, 'deg')})`)
if (scale) transforms.push(`scale(${parseMultiUnit(scale, '')})`)
if (skew) transforms.push(`skew(${parseMultiUnit(skew, 'deg')})`)

const styleList = {
  '--tfm': `${transforms.join(' ')};`,
  '--sec': `${parseUnit(seconds, 's')};`,
  '--dly': `${parseUnit(delay, 's')};`,
  ...style,
}
const classList = mergeClasses(className, id)
---

<Element class:list={classList} style={styleList} {...rest}><slot /></Element>

<style is:global>
  .ch-tfm > * {
    display: block;
    animation: tfm var(--sec) var(--dly) ease-in-out infinite alternate;
  }
  @keyframes tfm {
    100% {
      transform: var(--tfm);
    }
  }
</style>

---
import type { BackdropTitleProps } from './index.type'
import { id, props as defaultProps } from './index.props'
import { mergeClasses } from '../../utils'

interface Props extends BackdropTitleProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}

const { element, class: className, ...rest } = props

const Element = element as keyof HTMLElement

const styleList = {}
const classList = mergeClasses(className, id)
---

<Element class:list={classList} style={styleList} {...rest}>
  <span class="ch-bdt-c">
    <span class="ch-bdt-s">
      <slot name="subtitle" />
    </span>
    <span class="ch-bdt-t">
      <slot />
    </span>
  </span>
</Element>

<style lang="scss" is:global>
  .ch-bdt {
    text-align: center;
    line-height: 1.4;
  }
  .ch-bdt-c {
    display: inline-block;
  }
  .ch-bdt-t,
  .ch-bdt-s {
    display: block;
  }
  .ch-bdt-t {
    margin-top: -1.4em;
  }
  .ch-bdt-s {
    font-size: 3em;
    line-height: 1;
    color: #eee8;
  }
</style>

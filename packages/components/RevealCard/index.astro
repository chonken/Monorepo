---
import { mergeClasses, parseUnit } from '../../utils'
import type { RevealCardProps } from './index.type'
import { id, props as defaultProps } from './index.props'
import Content from '../Content/index.astro'

interface Props extends RevealCardProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}

const { element, class: className, src, minHeight, background, backgroundHover, mobile, ...rest } = props

const Element = element as keyof HTMLElement

const styleList = {
  '--src': `${src ? `url(${src})` : 'none'}`,
  '--min-h': parseUnit(minHeight, 'px'),
  '--bg': background,
  '--bg-h': backgroundHover,
}
const classList = mergeClasses(className, [id, mobile === 'none' ? '' : `mob-${mobile}`])
---

<Element class:list={classList} style={styleList} {...rest}>
  {
    Astro.slots.has('image') && (
      <div class="ch-rvc-i">
        <slot name="image" />
      </div>
    )
  }
  <div class="ch-rvc-c">
    <div class="ch-rvc-t"><slot name="title" /></div>
    <div class="ch-rvc-b"><slot /></div>
  </div>
</Element>

<style lang="scss" is:global>
  @use '../../config/breakpoint' as bp;

  .ch-rvc {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: end;
    min-height: var(--min-h);
    background: var(--src);
    z-index: 1;
    @at-root {
      .ch-rvc-i {
        position: absolute;
        inset: 0;
        & > * {
          width: 100%;
          height: 100% !important;
          object-fit: cover;
        }
        z-index: -1;
      }
      .ch-rvc-b {
        overflow: hidden;
        transition: 0.6s linear;
      }
    }
    @at-root :where(.ch-rvc) {
      & > .ch-rvc-c {
        display: grid;
        grid-template-rows: max-content minmax(0, 0fr);
        background: var(--bg);
        transition: 0.6s ease-in;
      }
      &:hover > .ch-rvc-c {
        grid-template-rows: max-content minmax(0, 1fr);
        background: var(--bg-h);
        transition-timing-function: ease-out;
      }
    }
  }

  // 手動設定尺寸
  $map: md, sm, xs, 2xs;

  @each $size in $map {
    @media (max-width: bp.size($size)) {
      .ch-rvc:where(.mob-#{$size}) {
        @at-root :where(.ch-rvc.mob-#{$size}) {
          & > .ch-rvc-c {
            grid-template-rows: max-content minmax(0, 1fr);
            background: var(--bg-h);
          }
          & .ch-rvc-i {
            position: static;
          }
        }
      }
    }
  }
</style>

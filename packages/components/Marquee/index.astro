---
import type { MarqueeProps } from './index.type'
import { id, props as defaultProps } from './index.props'
import { mergeClasses, parseUnit } from '../../utils'

interface Props extends MarqueeProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}
const { class: className, seconds, move, hover, mobile, gap, src, ...rest } = props

// 移動方向
const map = {
  left: [-1, 0],
  right: [1, 0],
  up: [0, -1],
  down: [0, 1],
}
const [hr, vr] = map[move] ?? [0, 0]

const styleList = {
  '--sec': parseUnit(seconds, 's'),
  '--tra': `translate(${hr * 100}%, ${vr * 100}%)`,
  '--tra-1': hr,
  '--tra-2': vr,
  '--gap': parseUnit(gap, 'px'),
}
const classList = mergeClasses(className, [id, `ch-dir-${move}`, hover ? 'ch-hover' : '', `mob-${mobile} `])
---

<div class:list={classList} style={styleList} {...rest}>
  <div class="ch-frame">
    <div class="ch-item">
      {Astro.slots.has('default') ? <slot /> : <img src={src} alt="" />}
    </div>
    <div class="ch-item ch-shadow">
      {Astro.slots.has('default') ? <slot /> : <img src={src} alt="" />}
    </div>
  </div>
</div>

<style lang="scss" is:global>
  @use '../../config/breakpoint' as bp;
  @use 'sass:map';

  .ch-mar {
    overflow: hidden;
    writing-mode: horizontal-tb;
    direction: ltr;
    &:where(.ch-dir-up, .ch-dir-down) {
      writing-mode: vertical-lr;
      max-width: fit-content;
    }
    &:where(.ch-dir-down, .ch-dir-right) {
      direction: rtl;
    }
    * {
      block-size: 100%;
    }
    @at-root :where(.ch-mar) {
      .ch-frame {
        --hr: var(--tra-1);
        --vr: var(--tra-2);
        position: relative;
        max-inline-size: none;
        inline-size: max-content;
        min-inline-size: 100%;
        animation: marquee var(--sec) linear infinite;
      }
      .ch-item {
        display: flex;
        justify-content: space-around;
        inline-size: max-content;
        > * {
          margin-inline-end: var(--gap);
        }
        * {
          block-size: 100% !important;
        }
      }
      .ch-shadow {
        position: absolute;
        inset-block-start: 0;
        inset-inline-start: 100%;
      }
    }
    @at-root {
      :where(.ch-mar.ch-hover):hover .ch-frame {
        animation-play-state: paused;
      }
    }
  }

  $map: 2xl, xl, lg, md, sm;
  @each $size in $map {
    @media (max-width: bp.size($size)) {
      :where(.ch-mar.mob-#{$size}):is(.ch-dir-up, .ch-dir-down) {
        writing-mode: horizontal-tb;
        max-width: 100%;
      }
      :where(.ch-mar.mob-#{$size}:is(.ch-dir-up, .ch-dir-down)) .ch-frame {
        --hr: var(--tra-2);
        --vr: var(--tra-1);
      }
    }
  }
  @keyframes marquee {
    100% {
      transform: translate(calc(var(--hr) * 100%), calc(var(--vr) * 100%));
    }
  }
</style>

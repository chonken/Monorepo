---
import { mergeClasses } from '../utils'
import type { ListLineProps } from './interface/_listLine.astro'
import ListLine from './interface/_listLine.astro'

export interface ProcessTimelineProps extends ListLineProps {}
interface Props extends ProcessTimelineProps {}

const { class: className = '', style, ...rest } = Astro.props

const defaults: ListLineProps = {
  element: 'ul',
  item: 'stretch',
  gap: '40',
  dotColor: '#878787',
  dotSize: '10px',
  dotCircle: false,
  lineGap: '5px',
  lineWidth: '1px',
  lineColor: '#878787',
  lineDotSize: '5px',
  lineDotColor: '#878787',
  lineDotCircle: false,
  trimStart: false,
  trimEnd: false,
  mobile: 'none',
}

const props: ListLineProps = {
  ...defaults,
  ...rest,
}

const styleList = {}
const classList = mergeClasses(className, ['ch-lll'])
---

<ListLine class:list={classList} style={styleList} {...props}><slot /></ListLine>

<style is:global>
  .ch-lll {
    overflow-block: clip;
  }
</style>

---
import type { ScaleProps } from './index.type'
import { id, props as defaultProps } from './index.props'
import { mergeClasses, parseUnit } from '../../utils'

interface Props extends ScaleProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}
const { element, class: className, scale, seconds, loop, ...rest } = props

const Element = element as keyof HTMLElement

const styleList = {
  '--sec': parseUnit(seconds, 's'),
  '--scl': scale,
}
const classList = mergeClasses(className, id)
---

<Element class:list={classList} style={styleList} {...rest}><slot /></Element>

<style is:global>
  .ch-scl > * {
    display: block;
    animation: scale var(--sec) infinite ease-in-out alternate-reverse;
  }
  @keyframes scale {
    100% {
      transform: scale(var(--scl));
    }
  }
</style>

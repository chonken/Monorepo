---
import type { TopLineListItemProps } from './Item.type'
import { id, props as defaultProps } from './Item.props'
import ItemLine from '../_prototype/itemLine.astro'
import { mergeClasses } from '../../utils'

interface Props extends TopLineListItemProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}
const { id: elId, class: className = '', lineClass, ...rest } = props

const classList = mergeClasses(className, id)
---

<li id={elId} class:list={classList} {...rest}>
  {
    Astro.slots.has('icon') && (
      <div class="ch-tlli-g">
        <slot name="icon" />
      </div>
    )
  }
  {
    Astro.slots.has('marker') ? (
      <ItemLine listDirection="row" markerClass="ch-tlli-m" lineClass={mergeClasses(lineClass, 'ch-tlli-l').join(' ')}>
        <slot name="marker" slot="marker" />
      </ItemLine>
    ) : (
      <ItemLine listDirection="row" markerClass="ch-tlli-m" lineClass={mergeClasses(lineClass, 'ch-tlli-l').join(' ')} />
    )
  }
  <div class="ch-tlli-t"><slot /></div>
</li>

<style lang="scss" is:global>
  @use '../../config/breakpoint' as bp;
  .ch-tlli {
    display: flex;
    flex-direction: column;
    margin-inline: 0 !important;
    padding-inline: 0 !important;
    max-width: calc(100% / var(--col));
    flex-grow: 1;
  }
  :is(.ch-tlli-g, .ch-tlli-m) {
    flex-shrink: 0;
  }
  .ch-tlli-g {
    padding-inline: var(--pd-s) var(--pd-e);
  }
  .ch-tlli-t {
    padding-inline: var(--pd-s) var(--pd-e);
    width: 100%;
    flex-grow: 1;
  }
  @each $size, $value in bp.$breakpoint {
    @media (max-width: #{$value}px) {
      .ch-tlli {
        max-width: calc(100% / var(--col-#{$size}));
      }
    }
  }
</style>

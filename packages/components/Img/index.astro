---
import { type ImgProps, id, props as defaultProps } from './index.type'
import { mergeClasses } from '../../utils'

interface Props extends ImgProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}

const { class: className, src, scale, cover, ...rest } = props

const classList = mergeClasses(className, [id, `${scale ? 'ch-img-scl' : ''}`, `${cover ? 'ch-img-cvr' : ''}`])
---

<div class:list={classList} {...rest}>
  <img src={src} alt="" />
</div>

<style is:global>
  .ch-img {
    width: fit-content;
  }
  .ch-img :where(img) {
    display: block;
    transition: 0.4s;
    min-height: 100%;
    object-fit: cover;
  }
  .ch-img-scl {
    overflow: hidden;
  }
  .ch-img-scl img:hover {
    transform: scale(1.1);
  }
</style>

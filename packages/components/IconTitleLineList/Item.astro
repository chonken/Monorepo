---
interface Props {
  class?: string
}
import { mergeClasses } from '../../utils'
const { class: className = '', ...rest } = Astro.props

const classList = mergeClasses(className, ['ch-itlli'])
---

<li class:list={classList} {...rest}>
  <div class="ch-itlli-i"><slot name="icon" /></div>
  <div class="ch-itlli-x">
    <div class="ch-itlli-t"><slot name="title" /></div>
    <slot />
  </div>
</li>

<style is:global>
  .ch-itlli {
    display: flex;
  }
  .ch-itlli-i {
    position: relative;
    z-index: 2;
    flex-shrink: 0;
  }
  .ch-itlli-i img {
    display: block;
    height: var(--ih) !important;
  }
  .ch-itlli-x {
    position: relative;
    padding-left: var(--gap);
    flex-grow: 1;
    z-index: 1;
  }
  .ch-itlli-t {
    position: relative;
    display: flex;
    align-items: center;
    line-height: 1.5;
    height: calc(var(--ih) / 2);
  }
  .ch-itlli-t::after {
    content: '';
    position: absolute;
    bottom: 0;
    right: 0;
    width: calc(100% + var(--gap) + var(--ih));
    border-bottom: 1px solid #bbb;
  }
</style>

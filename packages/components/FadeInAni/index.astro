---
import { mergeClasses, parseUnit } from '../../utils'
import type { FadeInAniProps } from './index.type'
import { id, props as defaultProps } from './index.props'

interface Props extends FadeInAniProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}
const { element, class: className, seconds, translate, move, ...rest } = props

const Element = element as keyof HTMLElement

// 移動方向
const map = {
  left: [-1, 0],
  right: [1, 0],
  up: [0, -1],
  down: [0, 1],
}
const [hr, vr] = map[move] ?? [0, 0]

const styleList = {
  '--sec': parseUnit(seconds, 's'),
  '--tra': `translate(calc(${parseUnit(translate, '%')} * ${hr}), calc(${parseUnit(translate, '%')} * ${vr}))`,
}
const classList = mergeClasses(className, id)
---

<Element class:list={classList} style={styleList} {...rest}><slot /></Element>

<style is:global>
  .ch-fad {
    width: fit-content;
    animation: hr-fad var(--sec) ease-in-out infinite;
  }
  @keyframes hr-fad {
    100% {
      opacity: 0;
      transform: var(--tra);
    }
  }
</style>

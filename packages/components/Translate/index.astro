---
import type { TranslateProps } from './index.type'
import { id, props as defaultProps } from './index.props'
import { mergeClasses, parseMultiUnit, parseUnit } from '../../utils'

interface Props extends TranslateProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}

const { element, class: className, translate, seconds, delay, ...rest } = props

const Element = element as keyof HTMLElement

const styleList = {
  '--tra': `translate(${parseMultiUnit(translate, '%')});`,
  '--sec': `${parseUnit(seconds, 's')};`,
  '--dly': `${parseUnit(delay, 's')};`,
}
const classList = mergeClasses(className, id)
---

<Element class:list={classList} style={styleList} {...rest}><slot /></Element>

<style is:global>
  .ch-tsl > * {
    display: block;
    animation: tsl var(--sec) var(--dly) ease-in-out infinite alternate;
  }
  @keyframes tsl {
    100% {
      transform: var(--tra);
    }
  }
</style>

---
import { mergeClasses } from '../../utils'
import Button from '../_prototype/button.astro'
import type { Btn11Props } from './index.type'
import { id, props as defaultProps } from './index.props'

interface Props extends Btn11Props {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}

const { class: className, color, hoverColor = color, backgroundColor, borderColor, ...rest } = props

const styleList = {
  '--clr': color,
  '--clr-h': hoverColor,
  '--bgc': backgroundColor,
  '--bor-c': borderColor,
}
const classList = mergeClasses(className, id)
---

<Button class:list={classList} style={styleList} {...rest}>
  <span class="ch-btnptt-txt">
    <slot>查看更多</slot>
  </span>
</Button>

<style lang="scss" is:global>
  .btn_type11 {
    color: var(--clr);
    border: 1px solid var(--bor-c);
    outline: 1px solid var(--bor-c);
    transition: 1.25s cubic-bezier(0.19, 1, 0.22, 1);
    &:hover {
      color: var(--clr-h);
      box-shadow:
        inset 0 0 20px var(--bor-c),
        0 0 20px -5px var(--bor-c);
      outline: 1px solid #fff0;
      outline-offset: 15px;
      text-shadow: 1px 1px 2px var(--clr-h);
    }
  }
</style>

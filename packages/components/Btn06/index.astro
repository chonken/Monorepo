---
import { mergeClasses } from '../../utils'
import Button from '../_prototype/button.astro'
import type { Btn06Props } from './index.type'
import { id, props as defaultProps } from './index.props'

interface Props extends Btn06Props {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}

const { class: className, color, backgroundColor, borderColor, hoverBorderColor, ...rest } = props

const styleList = {
  '--clr': color,
  '--bgc': backgroundColor,
  '--bor-c': borderColor,
  '--bor-c-h': hoverBorderColor,
}
const classList = mergeClasses(className, id)
---

<Button class:list={classList} style={styleList} {...rest}>
  <span class="btn_type06_l0"></span>
  <span class="btn_type06_l1"></span>
  <span class="btn_type06_l2"></span>
  <span class="btn_type06_l3"></span>
  <span class="ch-btnptt-txt"><slot>查看更多</slot></span>
</Button>

<style lang="scss" is:global>
  .btn_type06 {
    position: relative;
    color: var(--clr);
    background-color: var(--bgc);
    overflow: hidden;
    z-index: 1;
    &:hover [class^='btn_type06_l'] {
      transform: none;
    }
    & .ch-btnptt-txt {
      border: 2px solid var(--bor-c);
    }
  }
  [class^='btn_type06_l'] {
    content: '';
    position: absolute;
    border: solid var(--bor-c-h);
    z-index: 1;
    pointer-events: none;
    transition: 0.3s;
  }
  .btn_type06_l0,
  .btn_type06_l1 {
    top: 0;
    bottom: 0;
    border-left: 2px;
  }
  .btn_type06_l0 {
    left: 0;
    transform: translateY(calc(100% + 2px));
  }
  .btn_type06_l1 {
    right: 0;
    transform: translateY(calc(-100% - 2px));
  }
  .btn_type06_l2,
  .btn_type06_l3 {
    left: 0;
    right: 0;
    border-top: 2px;
  }
  .btn_type06_l2 {
    top: 0;
    transform: translateX(calc(-100% - 2px));
  }
  .btn_type06_l3 {
    bottom: 0;
    transform: translateX(calc(100% + 2px));
  }
</style>

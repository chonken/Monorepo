---
import { mergeClasses } from '../../utils'
import type { ContentProps } from './index.type'
import { id, props as defaultProps } from './index.props'

interface Props extends ContentProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}

const { element, class: className, direction, ...rest } = props

const Element = element as keyof HTMLElement

const styleList = {
  '--dir': direction,
}
const classList = mergeClasses(className, id)
---

<Element class:list={classList} style={styleList} {...rest}>
  <div class="ch-cnt-dir">
    <slot />
  </div>
</Element>

<style lang="scss" is:global>
  .ch-cnt {
    position: relative;
    z-index: 1;
    & p {
      margin-top: 1em;
    }
  }
  .ch-cnt-dir {
    display: contents;
    direction: var(--dir);
  }
</style>

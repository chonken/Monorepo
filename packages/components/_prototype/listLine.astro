---
import type { ListLineProps } from '../../types'
import { mergeClasses, parseUnit, parseDualUnit } from '../../utils'

interface Props extends ListLineProps {
  listDirection?: 'row' | 'column'
}

const { id, element = 'ol', class: className = '', style, item = 'center', gap = '40', lineGap = '0', trimStart = false, trimEnd = false, mobile = 'none', listDirection = 'column', dotStart = 'auto', ...rest } = Astro.props

const Element = element as keyof HTMLElement

// 解析並處理gap
const [rowGap, colGap] = parseDualUnit(gap, 'px')

// 處理對齊
const _gap = listDirection === 'column' ? rowGap : colGap
const space = listDirection === 'column' ? colGap : rowGap
const base = {
  stretch: { start: '0px', end: _gap },
  start: { start: '0px', end: _gap },
  center: { start: `calc(${_gap} / 2)`, end: `calc(${_gap} / 2)` },
  end: { start: _gap, end: '0px' },
}[item]
// 文字區padding間隔
const { start: StartPad, end: EndPad } = base
// 圖片區padding間隔
let ds = dotStart
if (ds === 'auto') {
  if (item === 'end') ds = '100%'
  if (item === 'stretch' || item === 'start') ds = '0px'
}

const styleList = {
  ...(listDirection === 'column' ? { '--cgap': space } : { '--rgap': space }),
  '--pd-s': StartPad,
  '--pd-e': EndPad,
  '--ds': parseUnit(ds, 'px'),
  '--l-gap': parseUnit(lineGap, 'px'),
  ...style,
}
const classList = mergeClasses(className, [trimStart ? 'trim-start' : '', trimEnd ? 'trim-end' : '', mobile === 'none' ? '' : `mob-${mobile}`])
---

<Element id={id} class:list={classList} style={styleList} {...rest}>
  <slot />
</Element>

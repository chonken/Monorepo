---
import { mergeClasses } from '../../utils'
import type { ItemLineProps } from '../../types'
interface Props extends ItemLineProps {
  listDirection?: 'row' | 'column'
}
const { dotClass = '', lineClass = '', listDirection = 'column', ...rest } = Astro.props
---

<div class:list={mergeClasses('ch-itlptt-m', listDirection === 'column' ? 'ch-col' : 'ch-row')} {...rest}>
  <div class:list={mergeClasses('ch-itlptt-l', lineClass)} {...rest}></div>
  <slot name="marker">
    <div class:list={mergeClasses('ch-itlptt-d', dotClass)}></div>
  </slot>
  <div class:list={mergeClasses('ch-itlptt-l', lineClass)} {...rest}></div>
</div>

<style lang="scss" is:global>
  .ch-itlptt-m {
    display: flex;
    align-items: center;
    gap: var(--l-gap);
    align-self: stretch !important;
    &:where(.ch-col) {
      flex-direction: column;
    }
    @at-root {
      .ch-itlptt-l {
        position: relative;
        flex-grow: 1;
        &::after {
          position: absolute;
          z-index: 1;
        }
      }
    }
    @at-root :where(&.ch-col) {
      .ch-itlptt-l {
        border-left: 1px solid #fff;
        &:where(:first-child) {
          min-height: var(--pd-s);
          height: var(--dt);
          max-height: var(--dt);
        }
        &:where(:last-child) {
          min-height: var(--pd-e);
        }
        &::after {
          left: 50%;
          transform: translateX(-50%);
        }
        &:where(:first-child)::after {
          content: '';
          bottom: 0;
        }
        &:where(:last-child)::after {
          content: '';
          top: 0;
        }
      }
    }
    @at-root :where(&.ch-row) {
      .ch-itlptt-l {
        border-top: 1px solid #fff;
        &:where(:first-child) {
          min-width: var(--pd-s);
          width: var(--dt);
          max-width: var(--dt);
        }
        &:where(:last-child) {
          min-width: var(--pd-e);
        }
        &::after {
          top: 50%;
          transform: translateY(-50%);
        }
        &:where(:first-child)::after {
          content: '';
          right: 0;
        }
        &:where(:last-child)::after {
          content: '';
          left: 0;
        }
      }
    }
    @at-root {
      .ch-itlptt-d {
        flex-shrink: 0;
      }
    }
  }
  .trim-start > :first-of-type > .ch-itlptt-m .ch-itlptt-l:first-child {
    opacity: 0;
  }
  .trim-end > :last-of-type > .ch-itlptt-m .ch-itlptt-l:last-child {
    opacity: 0;
  }
</style>

---
const { href, class: className, blank, ...rest } = Astro.props
---

<a href={href} class:list={[className, 'ch-btnptt']} target={blank ? '_blank' : undefined} {...rest}>
  <slot />
</a>

<style lang="scss" is:global>
  .ch-btnptt {
    display: inline-block;
    text-align: center;
    line-height: 1.2;
  }
  .ch-btnptt-txt {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5em;
    padding: 0.5em 1.5em;
  }
</style>

---
import { mergeClasses, parseMultiUnit } from '../../utils'
import type { TwoIconsTitleProps } from './index.type'
import { id, props as defaultProps } from './index.props'

interface Props extends TwoIconsTitleProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}
const { element, class: className, gap, mobile, ...rest } = props

const Element = element as keyof HTMLElement

const styleList = {
  '--gap': parseMultiUnit(gap).join(' '),
}
const classList = mergeClasses(className, [id, ...(mobile === 'none' ? [] : [`mob-${mobile}`])])
---

<Element class:list={classList} style={styleList} {...rest}>
  {
    Astro.slots.has('icon') ? (
      <div class="ch-tit-i">
        <slot name="icon" />
      </div>
    ) : (
      <div class="ch-tit-l" />
    )
  }
  <div class="ch-tit-t"><slot /></div>
  {Astro.slots.has('icon') ? <div class="ch-tit-i">{Astro.slots.has('icon2') ? <slot name="icon2" /> : <slot name="icon" />}</div> : <div class="ch-tit-l" />}
</Element>

<style lang="scss" is:global>
  @use '../../config/breakpoint' as bp;
  .ch-tit {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--gap);
    text-align: center;
  }
  .ch-tit-t {
    flex-shrink: 0;
  }
  .ch-tit-l {
    flex-grow: 1;
    border-top: 1px solid #000;
  }

  $map: (md, sm, xs, 2xl);

  @each $size in $map {
    @media (max-width: bp.size($size)) {
      .ch-tit.mob-#{$size} {
        :is(.ch-tit-l, .ch-tit-i) {
          display: none;
        }
      }
    }
  }
</style>

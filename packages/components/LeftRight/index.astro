---
import type { LeftRightProps } from './index.type'
import { id, props as defaultProps } from './index.props'
import { mergeClasses, parseUnit, parseDualUnit, isNegative, toNegative } from '../../utils'
import { containerStyleList, containerClassList } from '../Container/index.props'
import { flexClassList, flexStyleList } from '../../components/Flex/index.props'

interface Props extends LeftRightProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}
const { element, class: className, item, justify, gap: g, reverse, flexReverse, mobile, mobileItem, mobileFit, mobileReverse, maxWidth, center, overlay: oly, ...rest } = props

const Element = element as keyof HTMLElement

// 處理間距和疊層
const [rowGap, cGap] = parseDualUnit(g, 'px')
const o = toNegative(parseUnit(oly, 'px'))
const overlay = o === '-0px' ? (isNegative(cGap) ? cGap : '0px') : o
const colGap = overlay === '0px' ? cGap : '0px'
const gap = `${rowGap} ${colGap}`

const styleList = {
  ...containerStyleList({ maxWidth }),
  ...flexStyleList({ flexReverse, item, justify, gap, mobileItem }),
  '--oly': toNegative(parseUnit(overlay, 'px')),
}
const classList = mergeClasses(className, [
  id,
  ...containerClassList({ center }),
  ...flexClassList({
    reverse,
    flexReverse,
    mobile,
    mobileReverse,
  }),
  ...(mobile === 'none' ? [] : [mobileFit ? 'mob-fit' : '']),
])
---

<Element class:list={classList} style={styleList} {...rest}>
  <slot />
</Element>

<style lang="scss" is:global>
  @use '../../config/breakpoint' as bp;

  .ch-l-r {
    display: flex;
    justify-content: var(--jst);
    align-items: var(--itm);
    gap: var(--gap);
    width: var(--mw);
    max-width: 100%;
    &:where(.flex-re) {
      flex-direction: row-reverse;
    }
    &.ch-ctr-cen {
      margin-inline: auto;
    }
    > :where(:last-child) {
      margin-inline-start: var(--oly);
      z-index: 2;
    }
    > * {
      min-width: 0;
    }
  }

  // 手動設定尺寸
  $map: 2xl, xl, lg, md, sm;

  @each $size in $map {
    @media (max-width: bp.size($size)) {
      :where(.main-mob-#{$size}) .ch-l-r:where(.mob-inherit),
      .ch-l-r:where(.mob-#{$size}) {
        flex-direction: column;
        justify-content: var(--mob-jst);
        align-items: var(--mob-itm);
        &:where(.mob-re) {
          flex-direction: column-reverse;
        }
        &.mob-fit {
          margin-inline: auto;
          width: fit-content;
        }
        & > :last-child {
          margin-inline: 0;
        }
      }
    }
  }
</style>

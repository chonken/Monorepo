---
import type { ElementProps } from '../type/element'
import ListLine from './interface/_listLine.astro'
import { mergeClasses } from '../utils'

export interface LeftLineListItemProps extends ElementProps {}
interface Props extends LeftLineListItemProps {}

const { id, class: className = '', ...rest } = Astro.props

const classList = mergeClasses(className, ['ch-llli'])
---

<li id={id} class:list={classList} {...rest}>
  {
    Astro.slots.has('icon') && (
      <div class="ch-llli-g">
        <slot name="icon" />
      </div>
    )
  }
  <ListLine>
    <slot name="marker" slot="marker">
      <div class="ch-llli-d"></div>
    </slot>
  </ListLine>
  <div class="ch-llli-t"><slot /></div>
</li>

<style lang="scss" is:global>
  @use '../config/breakpoint' as bp;
  .ch-llli {
    display: flex;
    align-items: var(--itm);
    margin-block: 0 !important;
    padding-block: 0 !important;
    column-gap: var(--cgap);
  }
  .ch-llli:first-of-type {
    margin-top: calc(var(--rpd-t) * -1) !important;
  }
  .ch-llli:last-of-type {
    margin-bottom: calc(var(--rpd-b) * -1) !important;
  }
  :is(.ch-llli-g, .ch-llli-m) {
    flex-shrink: 0;
  }
  .ch-llli-g {
    padding-block: var(--rpd-t) var(--rpd-b);
  }
  .ch-llli-t {
    padding-block: var(--rpd-t) var(--rpd-b);
    flex-grow: 1;
  }
  .ch-llli-d {
    width: var(--dw);
    height: var(--dw);
    border-radius: var(--dr);
    background-color: var(--dc);
    flex-shrink: 0;
  }

  // 手動設定尺寸
  $map: lg, md, sm, xs, 2xs;

  @each $size in $map {
    @media (max-width: bp.size($size)) {
      .mob-#{$size} > .ch-llli {
        flex-direction: column;
        align-items: center;
        column-gap: 20px;
        &:first-of-type,
        &:last-of-type {
          margin-block: 0 !important;
        }
        & > .ch-itfll-m .ch-itfll-l {
          display: none;
        }
        & > .ch-llli-t {
          padding-block: 0 var(--cgap);
        }
        &:last-of-type {
          & > .ch-llli-t {
            padding-block: 0;
          }
        }
      }
    }
  }
</style>

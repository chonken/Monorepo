---
import { mergeClasses } from '../utils'
import type { ListLineProps } from './prototype/_listLine.astro'
import ListLine from './prototype/_listLine.astro'

export interface ProcessTimelineProps extends ListLineProps {
  element?: 'ol' | 'ul'
  evenReverse?: boolean
  mobileItem?: 'center' | 'start' | 'end'
}
interface Props extends ProcessTimelineProps {}

const { class: className = '', evenReverse = false, mobileItem = 'start', style, ...rest } = Astro.props

const defaults: ListLineProps = {
  element: 'ol',
  item: 'center',
  gap: '40',
  dotColor: '#878787',
  dotSize: '10px',
  dotCircle: false,
  lineGap: '5px',
  lineWidth: '1px',
  lineColor: '#878787',
  lineDotSize: '5px',
  lineDotColor: '#878787',
  lineDotCircle: false,
  trimStart: false,
  trimEnd: false,
  mobile: 'md',
}

const props: ListLineProps = {
  ...defaults,
  ...rest,
}

const styleList = {
  '--mob-lt': mobileItem === 'center' ? 'auto' : mobileItem === 'start' ? 0 : 100,
  '--mob-lb': mobileItem === 'center' ? 'auto' : mobileItem === 'end' ? 0 : 100,
}
const classList = mergeClasses(className, ['ch-ptl', evenReverse ? 'odd-reverse' : ''])
---

<ListLine class:list={classList} style={styleList} {...props}><slot /></ListLine>

<style is:global>
  .ch-ptl {
    overflow: hidden;
  }
</style>

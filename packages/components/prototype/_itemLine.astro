---
import { mergeClasses } from '../../utils'
interface Props {
  markerClass?: string
  lineClass?: string
  listDirection?: 'row' | 'column'
}
const { markerClass = '', lineClass = '', listDirection = 'column', ...rest } = Astro.props
---

<div class:list={mergeClasses(markerClass, ['ch-itfil-m', listDirection === 'column' ? 'ch-col' : 'ch-row'])} {...rest}>
  <div class:list={mergeClasses(lineClass, 'ch-itfil-l')} {...rest}></div>
  <slot name="marker">
    <div class="ch-itfil-d"></div>
  </slot>
  <div class:list={mergeClasses(lineClass, 'ch-itfil-l')} {...rest}></div>
</div>

<style lang="scss" is:global>
  .ch-itfil-m {
    display: flex;
    align-items: center;
    gap: var(--l-gap);
    align-self: stretch !important;
    &.ch-col {
      flex-direction: column;
    }
    &.ch-col .ch-itfil-l {
      border-left: var(--lw) solid var(--lc);
      &:first-child {
        min-height: var(--d-s);
        height: var(--dt);
        max-height: var(--dt);
      }
      &:last-child {
        min-height: var(--d-e);
      }
      &::after {
        left: calc((var(--lw) + var(--l-dw)) / -2);
      }
      &:first-child::after {
        content: '';
        bottom: 0;
      }
      &:last-child::after {
        content: '';
        top: 0;
      }
    }
    &.ch-row .ch-itfil-l {
      border-top: var(--lw) solid var(--lc);
      &:first-child {
        min-width: var(--d-s);
        width: var(--dt);
        max-width: var(--dt);
      }
      &:last-child {
        min-width: var(--d-e);
      }
      &::after {
        top: calc((var(--lw) + var(--l-dw)) / -2);
      }
      &:first-child::after {
        content: '';
        right: 0;
      }
      &:last-child::after {
        content: '';
        left: 0;
      }
    }
  }
  .ch-itfil-l {
    position: relative;
    flex-grow: 1;
    &::after {
      position: absolute;
      width: var(--l-dw);
      height: var(--l-dw);
      border-radius: var(--l-dr);
      background-color: var(--l-dc);
      z-index: 1;
    }
  }
  :first-of-type > .ch-itfil-m .ch-itfil-l:first-child {
    opacity: var(--ts);
  }
  :last-of-type > .ch-itfil-m .ch-itfil-l:last-child {
    opacity: var(--te);
  }
  .ch-itfil-d {
    width: var(--dw);
    height: var(--dw);
    border-radius: var(--dr);
    background-color: var(--dc);
    flex-shrink: 0;
  }
</style>

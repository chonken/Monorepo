---
import { mergeClasses } from '../../utils'

const { href, class: className, blank, ...rest } = Astro.props
---

<a href={href} class:list={mergeClasses(className, 'ch-btn')} target={blank ? '_blank' : undefined} {...rest}>
  {
    Astro.slots.has('icon') && (
      <span class="ch-icon">
        <slot name="icon" />
      </span>
    )
  }
  <slot>查看更多</slot>
</a>

<style lang="scss" is:global>
  .ch-btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 0.5em;
    padding: 0.5em 1.5em;
    line-height: 1.2;
    & .ch-icon {
      flex-shrink: 0;
      & img {
        display: block;
      }
    }
  }
</style>

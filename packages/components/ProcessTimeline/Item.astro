---
import type { ProcessTimelineItemProps } from './Item.type'
import { id, props as defaultProps } from './Item.props'
import ItemLine from '../_prototype/itemLine.astro'
import { mergeClasses } from '../../utils'

interface Props extends ProcessTimelineItemProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}

const { class: className, reverse, lineClass, dotClass, ...rest } = props

const classList = mergeClasses(className, [id, reverse ? 'reverse' : ''])
---

<li class:list={classList} {...rest}>
  <div class="ch-ptli-l">
    <slot name="left" />
  </div>
  {
    Astro.slots.has('marker') ? (
      <ItemLine lineClass={lineClass} dotClass={dotClass}>
        <slot name="marker" slot="marker" />
      </ItemLine>
    ) : (
      <ItemLine lineClass={lineClass} dotClass={dotClass} />
    )
  }
  <div class="ch-ptli-r">
    <slot />
    <slot name="right" />
  </div>
</li>

<style lang="scss" is:global>
  @use '../../config/breakpoint' as bp;
  .ch-ptli {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content minmax(0, 1fr);
    align-items: var(--itm);
    margin-block: 0 !important;
    padding-block: 0 !important;
    column-gap: var(--cgap);
    &:where(:first-of-type) {
      margin-top: calc(var(--pd-s) * -1) !important;
    }
    &:where(:last-of-type) {
      margin-bottom: calc(var(--pd-e) * -1) !important;
    }
  }
  :where(.ch-ptl.odd-reverse) > .ch-ptli:where(:nth-of-type(even)),
  .ch-ptli:where(.reverse) {
    direction: rtl;
  }
  .ch-ptli-l,
  .ch-ptli-r {
    padding-block: var(--pd-s) var(--pd-e);
  }

  // 手動設定尺寸
  $map: lg, md, sm, xs, 2xs;

  @each $size in $map {
    @media (max-width: bp.size($size)) {
      .mob-#{$size} > .ch-ptli {
        grid-template-columns: max-content 1fr;
        align-items: var(--mob-itm);
        column-gap: 20px;
        direction: ltr;
        & > .ch-ptli-l {
          padding-block-end: 0;
        }
        & > .ch-ptli-r {
          padding-block-start: 0;
        }
        & > .ch-itlptt-m {
          order: -1;
          grid-row: span 2;
          & .ch-itlptt-l:first-child {
            max-height: var(--mob-lt);
            height: var(--mob-lt);
          }
          & .ch-itlptt-l:last-child {
            max-height: var(--mob-lb);
            height: var(--mob-lb);
          }
        }
      }
    }
  }
</style>

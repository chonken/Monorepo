---
import type { Btn01Props } from './index.type'
import Button from '../../prototype/_button.astro'
import { id, props as defaultProps } from './index.props'
import { mergeClasses } from '../../../utils'

interface Props extends Btn01Props {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}
const { class: className, color, backgroundColor, shadow, ...rest } = props

const styleList = {
  '--clr': color,
  '--bgc': backgroundColor,
  '--shd': shadow,
}
const classList = mergeClasses(className, id)
---

<Button class:list={classList} style={styleList} {...rest}>
  {
    Astro.slots.has('icon') && (
      <span class="ch-icon">
        <slot name="icon" slot="icon" />
      </span>
    )
  }
  <slot />
</Button>

<style is:global>
  .btn_type01 {
    background: var(--bgc);
    color: var(--clr);
    line-height: 1.2;
    text-align: center;
  }
  .btn_type01:hover {
    transform: translate(-5px, -5px);
    box-shadow: 5px 5px 5px var(--shd);
  }
</style>

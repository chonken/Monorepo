---
import type { ContainerProps } from './index.type'
import { id, props as defaultProps, containerStyleList, containerClassList } from './index.props'
import { mergeClasses } from '../../utils'

interface Props extends ContainerProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}
const { element, class: className, maxWidth, center, ...rest } = props

const Element = element as keyof HTMLElement
const styleList = containerStyleList({ maxWidth })
const classList = mergeClasses(className, [id, ...containerClassList({ center })])
---

<Element class:list={classList} style={styleList} {...rest}><slot /></Element>

<style lang="scss" is:global>
  .ch-ctr {
    width: var(--mw);
    max-width: 100%;
    &.ch-ctr-cen {
      margin-inline: auto !important;
    }
  }
</style>

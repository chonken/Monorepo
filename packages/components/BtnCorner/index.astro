---
import { mergeClasses } from '../../utils'
import Button from '../_prototype/button.astro'
import type { BtnCornerProps } from './index.type'
import { id, props as defaultProps } from './index.props'

interface Props extends BtnCornerProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}

const { class: className, color, backgroundColor, hoverColor = backgroundColor, hoverBackgroundColor = color, position, blank, ...rest } = props

const map = {
  lt: 'ch-lt',
  rt: 'ch-rt',
  lb: 'ch-lb',
  rb: 'ch-rb',
}

const styleList = {
  '--clr': color,
  '--bgc': backgroundColor,
  '--clr-h': hoverColor,
  '--bgc-h': hoverBackgroundColor,
}
const classList = mergeClasses(className, [id, map[position]])
---

<Button class:list={classList} style={styleList} target={blank ? '_blank' : '_self'} {...rest}>
  <span class="ch-btnptt-txt">
    <slot>查看更多</slot>
  </span>
</Button>

<style lang="scss" is:global>
  .ch-btn-cnr {
    position: relative;
    color: var(--clr);
    background-color: var(--bgc);
    overflow: hidden;
    transition: 0.5s ease-in-out;
    z-index: 1;
    &::before {
      content: '';
      position: absolute;
      width: 0.7em;
      aspect-ratio: 1;
      background-color: var(--bgc-h);
      transition: 0.6s;
      transition-timing-function: ease-out;
      z-index: -1;
    }
    &.ch-lt::before {
      top: 0;
      left: 0;
      clip-path: polygon(0 0, 0% 100%, 100% 0);
    }
    &.ch-rt::before {
      top: 0;
      right: 0;
      clip-path: polygon(0 0, 100% 100%, 100% 0);
    }
    &.ch-lb::before {
      bottom: 0;
      left: 0;
      clip-path: polygon(0 0, 0% 100%, 100% 100%);
    }
    &.ch-rb::before {
      bottom: 0;
      right: 0;
      clip-path: polygon(100% 0, 0% 100%, 100% 100%);
    }
    &:hover {
      & > span {
        color: var(--clr-h);
      }
      &::before {
        width: 200%;
        transition-timing-function: ease-in;
      }
    }
  }
</style>

---
import { mergeClasses, parseUnit } from '../../utils'
import Button from '../prototype/_button.astro'
import type { BtnSwapProps } from './index.type'
import { id, props as defaultProps } from './index.props'

interface Props extends BtnSwapProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}

const { class: className, backgroundColor, color, borderColor = backgroundColor, hoverColor = backgroundColor, hoverBackgroundColor = color, borderRadius, iconHoverInvert, iconReverse, ...rest } = props

const styleList = {
  '--clr': color,
  '--bgc': backgroundColor,
  '--clr-h': hoverColor,
  '--bgc-h': hoverBackgroundColor,
  '--bor': parseUnit(borderColor, 'px'),
  '--brr': borderRadius,
  '--icn-inv': iconHoverInvert ? 1 : 0,
}
const classList = mergeClasses(className, [id, iconReverse ? 'ch-icon-re' : ''])
---

<Button class:list={classList} style={styleList} {...rest}>
  {
    Astro.slots.has('icon') && (
      <span class="ch-icon">
        <slot name="icon" slot="icon" />
      </span>
    )
  }
  <slot />
</Button>

<style lang="scss" is:global>
  .ch-btn-swap {
    text-align: center;
    color: var(--clr);
    border-radius: var(--brr);
    border: 1px solid var(--bor);
    background-color: var(--bgc);
    & .ch-icon {
      filter: none;
      transition: 0.4s;
    }
    &.ch-icon-re .ch-icon {
      filter: grayscale(1) invert(var(--icn-inv)) brightness(2);
    }
    &:hover {
      color: var(--clr-h);
      background-color: var(--bgc-h);
    }
    &:hover .ch-icon {
      filter: grayscale(1) invert(var(--icn-inv)) brightness(2);
    }
    &.ch-icon-re:hover .ch-icon {
      filter: none;
    }
  }
</style>

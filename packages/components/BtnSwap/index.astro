---
import { mergeClasses, parseUnit } from '../../utils'
import Button from '../_prototype/button.astro'
import type { BtnSwapProps } from './index.type'
import { id, props as defaultProps } from './index.props'

interface Props extends BtnSwapProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}
const { class: className, backgroundColor, color, borderColor = backgroundColor, hoverColor = backgroundColor, hoverBackgroundColor = color, ...rest } = props

const styleList = {
  '--clr': color,
  '--bgc': backgroundColor,
  '--clr-h': hoverColor,
  '--bgc-h': hoverBackgroundColor,
  '--bor': parseUnit(borderColor, 'px'),
}
const classList = mergeClasses(className, [id, 'ch-btnptt-txt'])
---

<Button class:list={classList} style={styleList} {...rest}>
  <slot>查看更多</slot>
</Button>

<style lang="scss" is:global>
  .ch-btn-swap {
    color: var(--clr);
    border: 1px solid var(--bor);
    background-color: var(--bgc);
    transition: 0.5s ease-in-out;
    &:hover {
      color: var(--clr-h);
      background-color: var(--bgc-h);
    }
  }
</style>

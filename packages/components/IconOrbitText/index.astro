---
import type { IconOrbitTextProps } from './index.type'
import { id, props as defaultProps } from './index.props'
import { mergeClasses } from '../../utils'
import Rotate from '../Rotate/index.astro'

interface Props extends IconOrbitTextProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}
const { element, class: className, seconds, reverse, ...rest } = props

const Element = element as keyof HTMLElement

const classList = mergeClasses(className, id)
---

<Element class:list={classList} {...rest}>
  <Rotate loop seconds={seconds} reverse={reverse} class="ch-iot-i"><slot name="icon" /></Rotate>
  <slot />
</Element>

<style lang="scss" is:global>
  .ch-iot {
    position: relative;
    width: fit-content;
    & img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center;
    }
    z-index: 1;
  }
  .ch-iot-i {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
</style>

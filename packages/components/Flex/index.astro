---
import type { FlexProps } from './index.type'
import { props as defaultProps, flexClassList, flexStyleList } from './index.type'
import { mergeClasses } from '../../utils'
import '../../styles/flex.scss'

interface Props extends FlexProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}
const { element, class: className,  wrap, item, justify, gap, reverse, flexReverse, mobile, mobileItem, mobileJustify, mobileReverse, ...rest } = props

const Element = element as keyof HTMLElement
const styleList = flexStyleList({  wrap, item, justify, gap, mobileItem, mobileJustify })
const classList = mergeClasses(className, flexClassList({ reverse, flexReverse, mobile, mobileReverse }))
---

<Element class:list={classList} style={styleList} {...rest}>
  <slot />
</Element>

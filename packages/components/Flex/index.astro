---
import type { FlexProps } from './index.type'
import { props as defaultProps } from './index.props'
import { flexClassList, flexStyleList } from './index.props'
import { mergeClasses, mergeStyles } from '../../utils'

interface Props extends FlexProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}
const { element, class: className, wrap, item, justify, gap, reverse, flexReverse, mobile, mobileItem, mobileJustify, mobileReverse, style, ...rest } = props

const Element = element as keyof HTMLElement
const styleList = mergeStyles(flexStyleList({ wrap, item, justify, gap, mobileItem, mobileJustify }), style)
const classList = mergeClasses(className, flexClassList({ reverse, flexReverse, mobile, mobileReverse }))
---

<Element class:list={classList} style={styleList} {...rest}>
  <slot />
</Element>

<style lang="scss" is:global>
  @use '../../config/breakpoint' as bp;

  .ch-flex {
    display: flex;
    flex-wrap: var(--wrp);
    justify-content: var(--jst);
    align-items: var(--itm);
    gap: var(--gap);
    &:where(.reverse) {
      direction: rtl;
    }
    &:where(.flex-re) {
      flex-direction: row-reverse;
    }
    > * {
      min-width: 0;
    }
  }

  @each $size, $value in bp.$breakpoint {
    @media (max-width: #{$value}px) {
      :where(.main-mob-#{$size}) .ch-flex:where(.mob-inherit),
      .ch-flex:where(.mob-#{$size}) {
        flex-direction: column;
        direction: unset;
        align-items: var(--mob-itm);
        &:where(.mob-re) {
          flex-direction: column-reverse;
        }
      }
    }
  }
</style>

---
import type { LeftLineListProps } from './List.type'
import { id, props as defaultProps } from './List.props'
import { mergeClasses } from '../../utils'
import ListLine from '../prototype/_listLine.astro'

interface Props extends LeftLineListProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}
const { class: className, item, ...rest } = props

const styleList = {
  '--itm': item,
}
const classList = mergeClasses(className, [id])
---

<ListLine class:list={classList} style={styleList} item={item} {...rest}>
  <slot />
</ListLine>

<style is:global>
  .ch-lll {
    overflow: hidden;
  }
</style>

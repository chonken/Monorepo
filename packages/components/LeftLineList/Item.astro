---
import type { LeftLineListItemProps } from './Item.type'
import { id, props as defaultProps } from './Item.props'
import ItemLine from '../_prototype/itemLine.astro'
import { mergeClasses } from '../../utils'

interface Props extends LeftLineListItemProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}
const { class: className, lineClass, dotClass, ...rest } = props

const classList = mergeClasses(className, id)
---

<li class:list={classList} {...rest}>
  {
    Astro.slots.has('icon') && (
      <div class="ch-llli-g">
        <slot name="icon" />
      </div>
    )
  }
  {
    Astro.slots.has('marker') ? (
      <ItemLine lineClass={lineClass} dotClass={dotClass}>
        <slot name="marker" slot="marker" />
      </ItemLine>
    ) : (
      <ItemLine lineClass={lineClass} dotClass={dotClass} />
    )
  }
  <div class="ch-llli-t"><slot /></div>
</li>

<style lang="scss" is:global>
  @use '../../config/breakpoint' as bp;
  .ch-llli {
    display: flex;
    align-items: var(--itm);
    margin-block: 0;
    padding-block: 0;
    column-gap: var(--cgap);
    &:where(:first-of-type) {
      margin-top: calc(var(--pd-s) * -1);
    }
    &:where(:last-of-type) {
      margin-bottom: calc(var(--pd-e) * -1);
    }
  }
  :is(.ch-llli-g, .ch-itlptt-m) {
    flex-shrink: 0;
  }
  .ch-llli-g {
    padding-block: var(--pd-s) var(--pd-e);
  }
  .ch-llli-t {
    padding-block: var(--pd-s) var(--pd-e);
    flex-grow: 1;
  }

  // 手動設定尺寸
  $map: lg, md, sm, xs, 2xs;

  @each $size in $map {
    @media (max-width: bp.size($size)) {
      .mob-#{$size} > .ch-llli {
        flex-direction: column;
        align-items: center;
        column-gap: 20px;
        &:first-of-type,
        &:last-of-type {
          margin-block: 0;
        }
        > .ch-llli-g + .ch-itlptt-m,
        > .ch-itlptt-m .ch-itlptt-l {
          display: none;
        }
        > .ch-llli-t {
          padding-block: 0 var(--cgap);
        }
        &:last-of-type {
          & > .ch-llli-t {
            padding-block: 0;
          }
        }
      }
    }
  }
</style>

---
import type { LeftLineListItemProps } from './Item.type'
import { id, props as defaultProps } from './Item.type'
import ItemLine from '../prototype/_itemLine.astro'
import { mergeClasses } from '../../utils'

interface Props extends LeftLineListItemProps {}

// 合併属性
const props = {
  ...defaultProps,
  ...Astro.props,
}
const { id: astroId, class: className, ...rest } = props

const classList = mergeClasses(className, [id])
---

<li id={astroId} class:list={classList} {...rest}>
  {
    Astro.slots.has('icon') && (
      <div class="ch-llli-g">
        <slot name="icon" />
      </div>
    )
  }
  {
    Astro.slots.has('marker') ? (
      <ItemLine markerClass="ch-llli-m" lineClass="ch-llli-l">
        <slot name="marker" slot="marker" />
      </ItemLine>
    ) : (
      <ItemLine markerClass="ch-llli-m" lineClass="ch-llli-l" />
    )
  }
  <div class="ch-llli-t"><slot /></div>
</li>

<style lang="scss" is:global>
  @use '../../config/breakpoint' as bp;
  .ch-llli {
    display: flex;
    align-items: var(--itm);
    margin-block: 0 !important;
    padding-block: 0 !important;
    column-gap: var(--cgap);
  }
  .ch-llli:first-of-type {
    margin-top: calc(var(--t-pd-s) * -1) !important;
  }
  .ch-llli:last-of-type {
    margin-bottom: calc(var(--t-pd-e) * -1) !important;
  }
  :is(.ch-llli-g, .ch-llli-m) {
    flex-shrink: 0;
  }
  .ch-llli-g {
    padding-block: var(--t-pd-s) var(--t-pd-e);
  }
  .ch-llli-t {
    padding-block: var(--t-pd-s) var(--t-pd-e);
    flex-grow: 1;
  }

  // 手動設定尺寸
  $map: lg, md, sm, xs, 2xs;

  @each $size in $map {
    @media (max-width: bp.size($size)) {
      .mob-#{$size} > .ch-llli {
        flex-direction: column;
        align-items: center;
        column-gap: 20px;
        &:first-of-type,
        &:last-of-type {
          margin-block: 0 !important;
        }
        & > .ch-llli-m .ch-llli-l {
          display: none;
        }
        & > .ch-llli-t {
          padding-block: 0 var(--cgap);
        }
        &:last-of-type {
          & > .ch-llli-t {
            padding-block: 0;
          }
        }
      }
    }
  }
</style>

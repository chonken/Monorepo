{
  "extends": "astro/tsconfigs/strict",
  "files": [],
  "references": [{ "path": "../components" }, { "path": "../layouts" }, { "path": "../utils" }],
  "compilerOptions": {
    "declaration": true,
    "outDir": "dist",
    "baseUrl": "../",
    "paths": {
      "@components/*": ["components/*", "components/*/index.astro"],
      "@layouts/*": ["layouts/*", "layouts/*/index.astro"],
      "@styles/*": ["styles/*"],
      "@utils": ["utils"],
      "@config/*": ["config/*"],
      "@tailwind": ["styles/tailwind.css"]
    },
    "types": ["astro/client"]
  },
  "exclude": ["dist"]
}

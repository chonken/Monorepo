---
import '@styles/normalize.css'
import '@tailwind'
import Main from '../layouts/Main.vue'
import config from '../save/config.json' with { type: 'json' }
---

<!-- ruler看看能不能移到docs的components -->
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" />
    <link rel="stylesheet" href="/src/styles/main.css" />
    <title>Storybook</title>
  </head>
  <body class={config.theme}>
    <div class="opsl flex w-full h-full text-lg text-[var(--text-main-1)] bg-[var(--bg-main-1)]">
      <!-- 紀錄: 當其他框架組件使用 client:load 時，會將該框架的組件進行水合，刷新元素，導致slot中的astro組件的事件註冊無法採用刷新的元素 -->
      <Main client:load></Main>
    </div>
  </body>
</html>

<script></script>

<style></style>

---
import '@tailwind'
import App from '../client/views/App.vue'
import { getConfig } from '../server/services/configs'
// 紀錄: 這裡是node環境，不是瀏覽器環境，路徑不能寫相對於瀏覽器根目錄，所以fetch要寫完整路徑，缺點就是localhost要寫死，所以要嘛改用瀏覽器環境寫fetch，要嘛就直接取資料庫
---

<!-- ruler看看能不能移到docs的components -->
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" />
    <link rel="stylesheet" href="/src/client/styles/main.css" />
    <title>Storybook</title>
  </head>
  <body class={String(getConfig('theme'))}>
    <div class="flex w-full h-full text-lg text-[var(--text-main-1)] bg-[var(--bg-main-1)]">
      <!-- 紀錄: 當其他框架組件使用 client:load 時，會將該框架的組件進行水合，刷新元素，導致slot中的astro組件的事件註冊無法採用刷新的元素 -->
      <App client:load />
    </div>
  </body>
</html>

<script></script>

<style></style>

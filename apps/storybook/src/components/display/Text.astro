---
interface Props {
  title?: string
  subtitle?: string
  text?: string[]
  style?: string
}
const { title, subtitle, text = [], style } = Astro.props
---

<div class="display_text" style={style}>
  <style is:inline>
    .display_text {
      display: flex;
      width: 750px;
      color: #333;
      background-color: #eeee;
      backdrop-filter: blur(5px);
    }
    .display_text-inner {
      margin: auto 0;
      padding: 40px 5%;
      width: 100%;
    }
  </style>
  <div class="display_text-inner">
    <hgroup>
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </hgroup>
    {text.map((item: string) => <p>{item}</p>)}
  </div>
</div>

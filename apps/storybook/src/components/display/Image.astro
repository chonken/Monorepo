---
interface Props {
  src: string
  style?: string
}
const { src, style } = Astro.props
---

<div class="display_image" style={style}>
  <img src={src} alt="" />
</div>

<style>
  .display_image {
    width: 600px;
    aspect-ratio: 600/400;
  }
  .display_image > img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

  "as": {
    "scope": "astro",
    "prefix": "as",
    "body": ["---", "interface Props {", "\tclass?: string", "}", "import { mergeClasses } from '@utils'", "const { class: className = '', ...rest } = Astro.props\n", "const classList = mergeClasses(className, ['$1'])", "---\n", "<div class:list={classList} {...rest}>", "\t", "</div>\n", "<style is:global>", "\t", "</style>"],
  },
  "as-fk": {
    "scope": "astro",
    "prefix": "as-fk",
    "body": ["---", "import YkFk from '../layouts/YongKingFuck.astro'", "import Debug from '@components/Debug'", "---\n", "<YkFk>", "\t", "</YkFk>", "<Debug/>\n", "<style is:global>", "\t", "</style>"],
  },
  "as-fk-index": {
    "scope": "astro",
    "prefix": "as-fk-index",
    "body": ["---", "import YkFk from '../layouts/YongKingFuck.astro'", "import Debug from '@components/Debug'", "---\n", "<YkFk keywords={[]}>", "\t", "</YkFk>", "<Debug/>\n", "<style is:global>", "\t", "</style>"],
  },
  "as-demo": {
    "scope": "astro",
    "prefix": "as-demo",
    "body": ["---", "import type { $1 } from './index.type'", "import { id, props as defaultProps } from './index.props'", "import { mergeClasses } from '../../utils'", "", "interface Props extends $1 {}", "", "// 合併属性", "const props = {", "  ...defaultProps,", "  ...Astro.props,", "}", "", "const { class: className, ...rest } = props", "", "const styleList = {}", "const classList = mergeClasses(className, id)", "---", "", "<div class:list={classList} style={styleList} {...rest}>", "  $2", "</div>", "", "<style lang='scss' is:global>", "  $3", "</style>"],
  },
  "ts-type-demo": {
    "scope": "typescript",
    "prefix": "ts-type-demo",
    "body": ["import { ElementProps } from '../../types'", "", "export interface $1 extends ElementProps {", "  $2", "}"],
  },

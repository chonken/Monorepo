---
interface Props {
  keywords?: string[]
}
import BaseModule from '@layouts/baseModule.astro'
const isIndex = Astro.url.pathname.endsWith('/index') || Astro.url.pathname === '/'
const isDev = import.meta.env.MODE === 'development'
const keywords = Astro.props.keywords || []
---

<BaseModule isIndex={isIndex} isDev={isDev} keywords={isIndex ? keywords : undefined}>
  <Fragment slot="demo">
    <!-- menu.css custom.css 放這裡 -->
  </Fragment>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@100..900&family=Noto+Serif+TC:wght@200..900&display=swap" rel="stylesheet" />
  </Fragment>
  <slot />
</BaseModule>

<style lang="scss" is:global>
  @use '@styles/generator.scss' as generator;
  @use '@config/breakpoint' as bp;

  // 字體大小
  $font-size: 18;
  // 字體參數設置
  $fmin: 16; // 字體大小最小區間
  $fmax: 80; // 字體大小最大區間
  $fupper: 0.8; // 最大基礎占比
  $flower: 0.5; // 保底基礎占比
  $fpower: 0.8; // 縮放指數
  // 空間大小
  $space: 20, 30, 40, 60, 80, 100, 125, 150, 200;
  // 空間參數設置
  $smin: 0; // 空間大小最小區間
  $smax: 400; // 空間大小最大區間
  $supper: 1; // 最大基礎占比
  $slower: 0.3; // 保底基礎占比
  $spower: 0.8; // 縮放指數
  // 縮放區間
  $lg: bp.value(2xl); // 縮放區間的最大尺寸
  $sm: bp.value(2xs); // 縮放區間的最小尺寸

  // 參數設置
  @mixin path_banner {
    // banner path 開關
    .path,
    .banner {
      display: none;
    }
  }
  @mixin opsl {
    // 模組區塊根元素
    font-size: var(--f18);
    font-family: 'Microsoft JhengHei', serif;
    overflow: hidden;
    line-height: 1.8;
    letter-spacing: 0;
  }
  @mixin animate {
    // opacity
    [data-animate-in='fadeIn'] {
      opacity: 0;
    }
    // transform
    [data-animate-in]:where(.trans-up),
    [data-animate-in='trans-up'] {
      --y: var(--ani-move-pos);
    }
    [data-animate-in]:where(.trans-left),
    [data-animate-in='trans-left'] {
      --x: var(--ani-move-pos);
    }
    [data-animate-in]:where(.trans-right),
    [data-animate-in='trans-right'] {
      --x: var(--ani-move-nag);
    }
    [data-animate-in]:where(.trans-down),
    [data-animate-in='trans-down'] {
      --y: var(--ani-move-nag);
    }
    [data-animate-in]:where(.trans-scaleIn),
    [data-animate-in='trans-scaleIn'] {
      --s: 0.3;
    }
    [data-animate-in]:where(.trans-rotateIn),
    [data-animate-in='trans-rotateIn'] {
      --r: -10deg;
    }
    // clip
    [data-animate-in]:where(.clip-up),
    [data-animate-in='clip-up'] {
      clip-path: polygon(0 100%, 100% 100%, 100% 100%, 0 100%);
    }
    [data-animate-in]:where(.clip-down),
    [data-animate-in='clip-down'] {
      clip-path: polygon(0 0, 100% 0, 100% 0, 0 0);
    }
    [data-animate-in]:where(.clip-left),
    [data-animate-in='clip-left'] {
      clip-path: polygon(100% 0, 100% 0, 100% 100%, 100% 100%);
    }
    [data-animate-in]:where(.clip-right),
    [data-animate-in='clip-right'] {
      clip-path: polygon(0 0, 0 0, 0 100%, 0 100%);
    }
    [data-animate-in]:where(.clip-scaleIn),
    [data-animate-in='clip-scaleIn'] {
      clip-path: circle(15% at 50% 50%);
    }
    // filter
    [data-animate-in]:where(.filter-blur),
    [data-animate-in='filter-blur'] {
      opacity: 0;
      filter: blur(10px);
    }
  }

  @include path_banner;
  .opsl {
    @include generator.generate-sizes('f', $font-size, $fmin, $fmax, $fupper, $flower, $fpower, $lg, $sm);
    @include generator.generate-sizes('s', $space, $smin, $smax, $supper, $slower, $spower, $lg, $sm);

    @include opsl;
  }
  [data-animate-in] {
    --ani-move-pos: clamp(40px, 10%, 50vw);
    --ani-move-nag: clamp(-40px, -10%, -50vw);
    transition:
      all 0.4s ease,
      opacity 0.4s ease,
      transform 1.2s ease,
      clip-path 1.2s ease,
      filter 1.2s ease;
  }
  [class*='trans-'],
  [data-animate-in^='trans-'] {
    opacity: 0;
    transform: translate(var(--x, 0), var(--y, 0)) scale(var(--s, 1)) rotate(var(--r, 0));
  }
  @include animate;
  .in-view:is(.clip-up, .clip-down, .clip-left, .clip-right, [data-animate-in='clip-up'], [data-animate-in='clip-down'], [data-animate-in='clip-left'], [data-animate-in='clip-right']) {
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
  }
  .in-view:is(.clip-scaleIn, [data-animate-in='clip-scaleIn']) {
    clip-path: circle(100% at 50% 50%);
  }
  .in-view:is([class*='filter-'], [data-animate-in^='filter-']) {
    filter: blur(0px) brightness(100%) contrast(100%) grayscale(0%) hue-rotate(0deg) invert(0%) opacity(100%) saturate(100%) sepia(0%);
  }
  .in-view:is([class*='trans-'], [data-animate-in^='trans-']) {
    transform: none;
  }
  .in-view[data-animate-in] {
    opacity: 1;
  }
</style>

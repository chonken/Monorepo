---
interface Props {
  keywords?: string[]
}
import BaseModule from '@layouts/baseModule.astro'
const isIndex = Astro.url.pathname.endsWith('/index') || Astro.url.pathname === '/'
const isDev = import.meta.env.MODE === 'development'
const keywords = Astro.props.keywords || []
---

<BaseModule root="opsl" isIndex={isIndex} isDev={isDev} keywords={isIndex ? keywords : undefined}>
  <Fragment slot="demo">
    <!-- menu.css custom.css 放這裡 -->
  </Fragment>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@100..900&family=Noto+Serif+TC:wght@200..900&display=swap" rel="stylesheet" />
  </Fragment>
  <slot />
</BaseModule>

<style lang="scss" is:global>
  @use 'sass:math';
  @use '../config/index.scss' as config;

  // reset module8
  .edit,
  .show_content,
  .main_part {
    width: 100% !important;
    max-width: 100% !important;
    margin: auto !important;
    padding: 0px !important;
  }
  .pageIndex .main_part {
    border: none !important;
  }
  .animated15 {
    animation: none;
  }
  @include config.path_banner;

  // 字體大小基礎占比
  @function base-ratio($value, $min, $max, $lower, $upper, $power) {
    // 超過區間
    @if $value < $min {
      @return $upper;
    } @else if $value > $max {
      @return $lower;
    }

    @return $lower + ($upper - $lower) * (1 - math.pow(math.div(($value - $min), ($max - $min)), $power));
  }
  .opsl {
    --base: 1rem;
    // 先取一個基礎值(--base * 占比)，值越小基礎值占比越大，剩餘換算成vw補齊
    @each $size in config.$font-size {
      $ratio: base-ratio($size, config.$fmin, config.$fmax, config.$flower, config.$fupper, config.$fpower);
      // 相對於--base的基礎值比例
      $fbase: math.div(math.round(math.div($size, 16) * $ratio * 100), 100);
      // vw補齊剩餘空間
      $fvw: math.div(math.round(math.div($size * (1 - $ratio), config.$lg) * 10000), 100);
      // 最小值
      $fmin: math.min(math.round($fbase * 16 + math.div(config.$sm * $fvw, 100)), 50);

      @if $fbase <= 0 {
        --f#{$size}: clamp(#{$fmin}px, #{$fvw}vw, #{$size}px);
      } @else {
        --f#{$size}: clamp(#{$fmin}px, calc(var(--base) * #{$fbase} + #{$fvw}vw), #{$size}px);
      }
    }
    @each $size in config.$space {
      $ratio: base-ratio($size, config.$smin, config.$smax, config.$slower, config.$supper, config.$spower);
      // 相對於--base的基礎值比例
      $sbase: math.div(math.round(math.div($size, 16) * $ratio * 100), 100);
      // vw補齊剩餘空間
      $svw: math.div(math.round(math.div($size * (1 - $ratio), config.$lg) * 10000), 100);
      // 最小值
      $smin: math.round($sbase * 16 + math.div(config.$sm * $svw, 100));

      @if $sbase <= 0 {
        --s#{$size}: clamp(#{$smin}px, #{$svw}vw, #{$size}px);
      } @else {
        --s#{$size}: clamp(#{$smin}px, calc(var(--base) * #{$sbase} + #{$svw}vw), #{$size}px);
      }
    }

    @include config.opsl;
  }

  [data-animate-in] {
    --ani-move-pos: clamp(40px, 10%, 50vw);
    --ani-move-nag: clamp(-40px, -10%, -50vw);
    transition:
      opacity 0.8s ease,
      transform 0.8s ease,
      clip-path 0.8s ease;
  }
  @include config.animate;
  .in-view:is([data-animate-in='clip-up'], [data-animate-in='clip-down'], [data-animate-in='clip-left'], [data-animate-in='clip-right']) {
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
  }
  .in-view:is([data-animate-in='clip-circle']) {
    clip-path: circle(100% at 50% 50%);
  }
  [data-animate-in].in-view {
    opacity: 1;
    transform: none;
  }
</style>

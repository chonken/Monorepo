---
interface Props {
  keywords?: string[]
  banner?: boolean
}
import BaseModule from '@layouts/baseModule.astro'
const isIndex = Astro.url.pathname.endsWith('/index') || Astro.url.pathname === '/'
const isDev = import.meta.env.MODE === 'development'

const { keywords = [], banner = false } = Astro.props
---

<BaseModule isIndex={isIndex} isDev={isDev} keywords={isIndex ? keywords : undefined} banner={banner}>
  <Fragment slot="demo">
    <!-- menu.css custom.css 放這裡 -->
  </Fragment>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@100..900&family=Noto+Serif+TC:wght@200..900&display=swap" rel="stylesheet" />
  </Fragment>
  <slot />
</BaseModule>

<style lang="scss" is:global>
  @use '@styles/generator.scss' as generator;
  @use '@config/breakpoint' as bp;

  $font-base: 1rem;
  // 字體大小 (腳本自動更新)
  $font-size: 18;
  // 字體參數設置
  $fmin: 16; // 字體大小最小區間
  $fmax: 80; // 字體大小最大區間
  $fupper: 0.8; // 最大基礎占比
  $flower: 0.5; // 保底基礎占比
  $fpower: 0.8; // 縮放指數

  $space-base: 1rem;
  // 空間大小 (腳本自動更新)
  $space: 40;
  // 空間參數設置
  $smin: 0; // 空間大小最小區間
  $smax: 400; // 空間大小最大區間
  $supper: 1; // 最大基礎占比
  $slower: 0.3; // 保底基礎占比
  $spower: 0.8; // 縮放指數

  // 縮放區間
  $lg: bp.value(2xl); // 縮放區間的最大尺寸
  $sm: bp.value(2xs); // 縮放區間的最小尺寸

  @mixin opsl {
    // 模組區塊根元素
    font-size: var(--f18);
    font-family: 'Microsoft JhengHei', serif;
    contain: paint;
    line-height: 1.8;
    letter-spacing: 0;
  }
  @mixin animate {
    [data-animate-in='up'] {
      opacity: 0;
      transform: translate3d(0, var(--ani-move-pos), 0);
    }
    [data-animate-in='left'] {
      opacity: 0;
      transform: translate3d(var(--ani-move-pos), 0, 0);
    }
    [data-animate-in='right'] {
      opacity: 0;
      transform: translate3d(var(--ani-move-nag), 0, 0);
    }
    [data-animate-in='down'] {
      opacity: 0;
      transform: translate3d(0, var(--ani-move-nag), 0);
    }
    [data-animate-in='scaleIn'] {
      opacity: 0;
      transform: scale(0.3);
    }
    [data-animate-in='fadeIn'] {
      opacity: 0;
    }
  }

  .opsl {
    @include generator.generate-sizes($font-base, 'f', $font-size, $fmin, $fmax, $fupper, $flower, $fpower, $lg, $sm);
    @include generator.generate-sizes($space-base, 's', $space, $smin, $smax, $supper, $slower, $spower, $lg, $sm);

    @include opsl;
  }
  [data-animate-in] {
    --ani-move-pos: clamp(40px, 10%, 50vw);
    --ani-move-nag: clamp(-40px, -10%, -50vw);
    transition:
      all 0.4s ease,
      opacity 0.4s ease,
      transform 1.2s ease,
      clip-path 1.2s ease,
      filter 1.2s ease;
  }
  @include animate;
  .in-view {
    &[data-animate-in] {
      opacity: 1;
    }
    &:is([class*='trans-'], [data-animate-in^='trans-'], [data-animate-in='up'], [data-animate-in='down'], [data-animate-in='left'], [data-animate-in='right'], [data-animate-in='scaleIn']) {
      transform: none;
    }
  }
</style>
